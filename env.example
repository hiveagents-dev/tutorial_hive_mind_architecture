# Variables de entorno para HiveMind Architecture
# Copia este archivo como .env y configura tus valores

# API Key de Google Gemini (REQUERIDO)
GOOGLE_API_KEY=your_gemini_api_key_here

# Configuración del modelo Gemini
GEMINI_MODEL=gemini-flash-lite-latest
TEMPERATURE=0.7
MAX_TOKENS=4000

# Configuración por defecto del sistema
DEFAULT_METHODOLOGY=scrum
DEFAULT_CONSENSUS_STRATEGY=weighted_voting

# Configuración de la API REST
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_LOG_LEVEL=info

# Configuración de logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Configuración de archivos de salida
OUTPUT_DIR=./output
LOG_DIR=./logs
